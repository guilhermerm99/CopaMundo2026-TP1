<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>


<VBox
        spacing="12"
        style="-fx-padding: 16 19 16 19;"
        xmlns="http://javafx.com/javafx/26"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="copamundo.partidas.visao.TelaConsultaPartidasController">


    <GridPane hgap="8" vgap="10">
        <columnConstraints>
            <ColumnConstraints hgrow="NEVER" minWidth="90" prefWidth="110" />
            <ColumnConstraints hgrow="ALWAYS" prefWidth="200" />
            <ColumnConstraints hgrow="NEVER" minWidth="70" prefWidth="90" />
            <ColumnConstraints hgrow="ALWAYS" prefWidth="200" />
        </columnConstraints>
        <rowConstraints>
            <RowConstraints vgrow="NEVER" minHeight="30" />
            <RowConstraints vgrow="NEVER" minHeight="30" />
        </rowConstraints>


        <Label text="Data:" style="-fx-font-weight: bold; -fx-font-size: 15;" GridPane.halignment="RIGHT" />
        <TextField fx:id="textoData" promptText="Informe a data" maxWidth="1.7976931348623157E308"
                   GridPane.columnIndex="1" />

        <Label text="Fase:" style="-fx-font-weight: bold; -fx-font-size: 15;"
               GridPane.columnIndex="2" GridPane.halignment="RIGHT" />
        <ComboBox fx:id="seletorFase" promptText="Selecionar" maxWidth="1.7976931348623157E308"
                  GridPane.columnIndex="3" />

        <Label text="Seleção:" style="-fx-font-weight: bold; -fx-font-size: 15;"
               GridPane.rowIndex="1" GridPane.halignment="RIGHT" />
        <ComboBox fx:id="seletorSelecao" promptText="Selecionar" maxWidth="1.7976931348623157E308"
                  GridPane.columnIndex="1" GridPane.rowIndex="1" />

        <Label text="Status:" style="-fx-font-weight: bold; -fx-font-size: 15;"
               GridPane.columnIndex="2" GridPane.rowIndex="1" GridPane.halignment="RIGHT" />
        <ComboBox fx:id="seletorStatus" promptText="Selecionar" maxWidth="1.7976931348623157E308"
                  GridPane.columnIndex="3" GridPane.rowIndex="1" />
    </GridPane>


    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button fx:id="btnFiltrarConsulta" text="Filtrar"
                onAction="#filtrarListaPartidas"
                textFill="WHITE"
                style="-fx-background-color: #2E7D32; -fx-font-weight: bold; -fx-font-size: 13;"
                prefWidth="90" />
        <Button fx:id="btnLimparFiltros" text="Limpar filtros"
                onAction="#limparFiltros"
                textFill="WHITE"
                style="-fx-background-color: #D32F2F; -fx-font-weight: bold; -fx-font-size: 13;" />
    </HBox>


    <TableView fx:id="tabelaInteira" VBox.vgrow="ALWAYS" maxWidth="1.7976931348623157E308">
        <columns>
            <TableColumn fx:id="colunaData"      text="Data"      prefWidth="89" />
            <TableColumn fx:id="colunaHorario"   text="Horário"   prefWidth="67" />
            <TableColumn fx:id="colunaEstadio"   text="Estádio"   prefWidth="135" />
            <TableColumn fx:id="colunaFase"      text="Fase"      prefWidth="139" />
            <TableColumn fx:id="colunaSelecoes"  text="Seleções"  prefWidth="204" />
            <TableColumn fx:id="colunaPlacar"    text="Placar"    prefWidth="104" />
            <TableColumn fx:id="colunaStatus"    text="Status"    prefWidth="131" />
            <TableColumn fx:id="colunaEditar"    text="Editar"    prefWidth="78" />
            <TableColumn fx:id="colunaExcluir"   text="Excluir"   prefWidth="73" />
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
        </columnResizePolicy>
    </TableView>

</VBox>