<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="15" stylesheets="@estilo.css"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="copamundo.estadios.visao.TelaCadastroArbitroController">

    <padding>
        <Insets bottom="15" left="15" right="15" top="15"/>
    </padding>

    <Label text="Cadastro de Arbitros" styleClass="label-titulo"/>

    <GridPane hgap="10" vgap="10">
        <Label text="Nome:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="txtNome" promptText="Nome do arbitro"
                   GridPane.rowIndex="0" GridPane.columnIndex="1"/>

        <Label text="Federacao/Nacionalidade:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <TextField fx:id="txtFederacao" promptText="Federacao ou nacionalidade"
                   GridPane.rowIndex="1" GridPane.columnIndex="1"/>

        <Label text="Categoria:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <ComboBox fx:id="cbCategoria" promptText="Selecione"
                  GridPane.rowIndex="2" GridPane.columnIndex="1"/>

        <Label text="Experiencia:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
        <ComboBox fx:id="cbExperiencia" promptText="Selecione"
                  GridPane.rowIndex="3" GridPane.columnIndex="1"/>
    </GridPane>

    <HBox spacing="10" alignment="CENTER">
        <Button text="Novo" onAction="#limparCampos"/>
        <Button text="Salvar" onAction="#salvarArbitro"/>
        <Button text="Limpar" onAction="#limparCampos"/>
    </HBox>

    <TableView fx:id="tabelaArbitros" prefHeight="220">
        <columns>
            <TableColumn fx:id="colunaNome" text="Nome" prefWidth="180"/>
            <TableColumn fx:id="colunaFederacao" text="Federacao/Nacionalidade" prefWidth="180"/>
            <TableColumn fx:id="colunaCategoria" text="Categoria" prefWidth="120"/>
            <TableColumn fx:id="colunaExperiencia" text="Experiencia" prefWidth="120"/>
        </columns>
    </TableView>

</VBox>
