<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="15" stylesheets="@estilo.css"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="copamundo.estadios.visao.TelaDesignacaoArbitroController">

    <padding>
        <Insets bottom="15" left="15" right="15" top="15"/>
    </padding>

    <Label text="Designacao de Arbitros" styleClass="label-titulo"/>

    <GridPane hgap="10" vgap="10">
        <Label text="Arbitro:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <ComboBox fx:id="cbArbitro" promptText="Selecione o arbitro"
                  GridPane.rowIndex="0" GridPane.columnIndex="1"/>

        <Label text="Partida:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <ComboBox fx:id="cbPartida" promptText="Selecione a partida existente"
                  GridPane.rowIndex="1" GridPane.columnIndex="1"/>
    </GridPane>

    <HBox spacing="10" alignment="CENTER">
        <Button text="Designar" onAction="#designarArbitro"/>
        <Button text="Limpar" onAction="#limparCampos"/>
    </HBox>

    <TableView fx:id="tabelaDesignacoes" prefHeight="220">
        <columns>
            <TableColumn fx:id="colunaEstadio" text="Estadio" prefWidth="140"/>
            <TableColumn fx:id="colunaArbitro" text="Arbitro" prefWidth="140"/>
            <TableColumn fx:id="colunaPartida" text="Partida" prefWidth="160"/>
            <TableColumn fx:id="colunaData" text="Data/Hora" prefWidth="150"/>
        </columns>
    </TableView>

</VBox>
