<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="520.0" prefWidth="820.0" style="-fx-background-color: #2E7D32;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="copamundo.usuarios.controle.TelaLoginController">

    <children>

        <ImageView fitHeight="520.0" fitWidth="820.0" preserveRatio="false" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <image>
                <Image url="@estadio.png" />
            </image>
        </ImageView>

        <HBox alignment="CENTER" prefHeight="520.0" prefWidth="820.0" style="-fx-background-color: rgba(0,0,0,0.24);" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">

            <children>
                <VBox alignment="CENTER" prefHeight="415.0" prefWidth="270.0" spacing="9.0" style="-fx-background-color: rgba(255,255,255,0.80); -fx-background-radius: 18; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.35), 18, 0, 0, 5);">

                    <children>
                        <Label text="⚽" textFill="#2E7D32">
                            <font>
                                <Font name="Arial Bold" size="31.0" />
                            </font>
                        </Label>

                        <Label text="Login" textFill="#2E7D32">
                            <font>
                                <Font name="Arial Bold" size="21.0" />
                            </font>
                        </Label>

                        <Label text="Sistema Copa do Mundo 2026" textFill="#555555">
                            <font>
                                <Font name="Arial" size="10.5" />
                            </font>
                        </Label>

                        <VBox alignment="CENTER_LEFT" prefHeight="108.0" prefWidth="205.0" spacing="4.0">

                            <children>
                                <Label text="E-mail" textFill="#555555" />

                                <TextField fx:id="campoEmail" prefWidth="205.0" promptText="E-mail" style="-fx-background-radius: 15;                                                   -fx-background-color: rgba(255,255,255,0.86);                                                   -fx-focus-color: #2E7D32;                                                   -fx-faint-focus-color: transparent;" />

                                <Label text="Senha" textFill="#555555" />

                                <PasswordField fx:id="campoSenha" prefWidth="205.0" promptText="Senha" style="-fx-background-radius: 15;                                                       -fx-background-color: rgba(255,255,255,0.86);                                                       -fx-focus-color: #2E7D32;                                                       -fx-faint-focus-color: transparent;" />
                            </children>
                        </VBox>

                        <Button fx:id="entrar" mnemonicParsing="false" onAction="#entrar" prefHeight="28.0" prefWidth="205.0" style="-fx-background-radius: 15;                                        -fx-background-color: #2E7D32;                                        -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.25), 12, 0, 0, 3);                                        -fx-cursor: hand;" text="Entrar" textFill="WHITE">

                            <VBox.margin>
                                <Insets bottom="3.0" />
                            </VBox.margin>
                        </Button>
                    </children>

                    <padding>
                        <Insets bottom="18.0" left="28.0" right="28.0" top="18.0" />
                    </padding>
                </VBox>
            </children>
         <padding>
            <Insets bottom="70.0" top="70.0" />
         </padding>
        </HBox>
    </children>
</AnchorPane>
