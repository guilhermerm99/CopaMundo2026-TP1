<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<AnchorPane xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="copamundo.usuarios.controle.TelaUsuariosController">

    <children>
        <BorderPane AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">

            <center>
                <StackPane fx:id="contentArea" BorderPane.alignment="CENTER">
                    <children>

                        <VBox spacing="14.0" style="-fx-background-color: #DCDCDC;" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">

                            <children>
                                <HBox maxWidth="Infinity" spacing="25.0">
                                    <children>

                                        <VBox prefHeight="85.0" prefWidth="323.0" spacing="5.0">
                                            <children>
                                                <HBox alignment="CENTER_LEFT" prefHeight="25.0" spacing="5.0">
                                                    <children>
                                                        <Label text="Nome:">
                                                            <font>
                                                                <Font name="System Bold" size="12.0" />
                                                            </font>
                                                        </Label>
                                                        <TextField fx:id="campoNomeUsuario" prefHeight="25.0" prefWidth="242.0" promptText="Nome do usuário" style="-fx-faint-focus-color: transparent; -fx-focus-color: #2E7D32;" />
                                                    </children>
                                                </HBox>

                                                <HBox alignment="CENTER_LEFT" prefHeight="25.0" spacing="5.0">
                                                    <children>
                                                        <Label text="Função:">
                                                            <font>
                                                                <Font name="System Bold" size="12.0" />
                                                            </font>
                                                        </Label>
                                                        <ComboBox fx:id="campoFuncao" prefHeight="25.0" prefWidth="235.0" promptText="Função" style="-fx-faint-focus-color: transparent; -fx-focus-color: #2E7D32;" />
                                                    </children>
                                                </HBox>

                                                <HBox alignment="CENTER_LEFT" prefHeight="25.0" spacing="5.0">
                                                    <children>
                                                        <Label text="Status:">
                                                            <font>
                                                                <Font name="System Bold" size="12.0" />
                                                            </font>
                                                        </Label>
                                                        <ComboBox fx:id="campoStatus" prefHeight="25.0" prefWidth="241.0" promptText="Status" style="-fx-faint-focus-color: transparent; -fx-focus-color: #2E7D32;" />
                                                    </children>
                                                </HBox>
                                            </children>
                                        </VBox>

                                        <VBox prefHeight="85.0" prefWidth="283.0" spacing="5.0">
                                            <children>
                                                <HBox alignment="CENTER_LEFT" prefHeight="25.0" spacing="5.0">
                                                    <children>
                                                        <Label text="Cpf:">
                                                            <font>
                                                                <Font name="System Bold" size="12.0" />
                                                            </font>
                                                        </Label>
                                                        <TextField fx:id="campoCpfUsuario" prefHeight="25.0" prefWidth="246.0" promptText="Cpf" style="-fx-faint-focus-color: transparent; -fx-focus-color: #2E7D32;" />
                                                    </children>
                                                </HBox>

                                                <HBox alignment="CENTER_LEFT" prefHeight="25.0" spacing="5.0">
                                                    <children>
                                                        <Label prefHeight="17.0" prefWidth="32.0" text="País:">
                                                            <font>
                                                                <Font name="System Bold" size="12.0" />
                                                            </font>
                                                        </Label>
                                                        <ComboBox fx:id="campoPais" prefHeight="25.0" prefWidth="237.0" promptText="País" style="-fx-faint-focus-color: transparent; -fx-focus-color: #2E7D32;" />
                                                    </children>
                                                </HBox>

                                                <Button mnemonicParsing="false" onAction="#buscarUsuarios" style="-fx-background-radius: 15; -fx-background-color: white; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.2), 12, 0, 0, 3);">
                                                    <graphic>
                                                        <FontIcon iconLiteral="fas-search" />
                                                    </graphic>
                                                </Button>
                                            </children>
                                        </VBox>

                                    </children>

                                    <padding>
                                        <Insets left="20.0" right="10.0" />
                                    </padding>
                                </HBox>

                                <TableView fx:id="tabelaUsuarios" maxHeight="Infinity" maxWidth="Infinity" prefHeight="303.0" style="-fx-background-radius: 9;                                                   -fx-body-color: #2E7D32;                                                   -fx-outer-border: #2E7D32;                                                   -fx-inner-border: #2E7D32;                                                   -fx-control-inner-background: white;                                                   -fx-control-inner-background-alt: #E8F5E9;                                                   -fx-table-cell-border-color: #C8E6C9;                                                   -fx-selection-bar: #A5D6A7;                                                   -fx-selection-bar-non-focused: #C8E6C9;" VBox.vgrow="ALWAYS">

                                    <columns>
                                        <TableColumn fx:id="colunaNome" prefWidth="102.0" text="Nome" />
                                        <TableColumn fx:id="colunaCpf" prefWidth="101.0" text="CPF" />
                                        <TableColumn fx:id="colunaFuncao" prefWidth="101.0" text="Função" />
                                        <TableColumn fx:id="colunaPais" prefWidth="101.0" text="País" />
                                        <TableColumn fx:id="colunaStatus" prefWidth="101.0" text="Status" />
                                    </columns>

                                    <columnResizePolicy>
                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                    </columnResizePolicy>
                                </TableView>

                                <HBox alignment="CENTER_RIGHT" prefHeight="47.0" spacing="10.0">
                                    <children>
                                        <Button fx:id="btnEditar" mnemonicParsing="false" onAction="#telaEditar" style="-fx-background-color: white; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.2), 12, 0, 0, 3);">
                                            <graphic>
                                                <FontIcon iconLiteral="fas-pencil-alt" />
                                            </graphic>
                                        </Button>

                                        <Button fx:id="btnCadastrar" mnemonicParsing="false" onAction="#telaCadastro" style="-fx-background-color: #2E7D32; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.2), 12, 0, 0, 3);" text="Cadastrar Novo Usuário" textFill="WHITE" />

                                        <Button fx:id="btnExcluir" mnemonicParsing="false" onAction="#telaExcluir" style="-fx-background-color: #b22222; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.2), 12, 0, 0, 3);" text="Excluir" textFill="WHITE" />
                                    </children>
                                </HBox>
                            </children>

                            <padding>
                                <Insets bottom="15.0" left="10.0" right="10.0" top="15.0" />
                            </padding>
                        </VBox>

                    </children>
                </StackPane>
            </center>
        </BorderPane>
    </children>
</AnchorPane>
