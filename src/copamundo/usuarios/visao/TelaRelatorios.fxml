<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<AnchorPane xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="copamundo.usuarios.controle.TelaRelatoriosController">

    <children>
        <BorderPane style="-fx-background-color: #DCDCDC;" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">

            <center>
                <ScrollPane fitToHeight="true" fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;" BorderPane.alignment="CENTER">

                    <content>
                        <VBox maxWidth="Infinity" spacing="10.0" style="-fx-background-color: #DCDCDC;">

                            <padding>
                                <Insets bottom="12.0" left="12.0" right="12.0" top="12.0" />
                            </padding>

                            <children>

                                <VBox maxWidth="Infinity" spacing="8.0" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 12; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.16), 10, 0, 0, 3);">

                                    <children>
                                        <Label text="Painel de relatórios" textFill="#2E7D32">
                                            <font>
                                                <Font name="System Bold" size="16.0" />
                                            </font>
                                        </Label>

                                        <HBox alignment="CENTER_LEFT" spacing="8.0">
                                            <children>
                                                <ComboBox fx:id="comboTipoRelatorio" maxWidth="Infinity" promptText="Tipo" HBox.hgrow="ALWAYS" />

                                                <ComboBox fx:id="comboSelecao" maxWidth="Infinity" promptText="Seleção" HBox.hgrow="ALWAYS" />

                                                <DatePicker fx:id="dateInicio" maxWidth="Infinity" promptText="Início" HBox.hgrow="ALWAYS" />

                                                <DatePicker fx:id="dateFim" maxWidth="Infinity" promptText="Fim" HBox.hgrow="ALWAYS" />
                                            </children>
                                        </HBox>

                                        <HBox alignment="CENTER_RIGHT" spacing="8.0">
                                            <children>
                                                <Button mnemonicParsing="false" onAction="#handleGerarRelatorio" style="-fx-background-color: #FFFFFF; -fx-border-color: #CFCFCF;" text="Visualizar" />

                                                <Button mnemonicParsing="false" onAction="#handleGerarPDF" style="-fx-background-color: #2E7D32; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.2), 10, 0, 0, 3);" text="Gerar PDF" textFill="WHITE">

                                                    <graphic>
                                                        <FontIcon iconColor="WHITE" iconLiteral="fas-file-pdf" />
                                                    </graphic>
                                                </Button>
                                            </children>
                                        </HBox>
                                    </children>
                                </VBox>

                                <HBox spacing="10.0">
                                    <children>
                                        <VBox maxWidth="Infinity" spacing="3.0" style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.14), 8, 0, 0, 2);" HBox.hgrow="ALWAYS">

                                            <children>
                                                <Label fx:id="lblTituloCard1" text="Partidas" textFill="#606060" />
                                                <Label fx:id="lblNumeroPartidas" text="0" textFill="#2E7D32">
                                                    <font>
                                                        <Font name="System Bold" size="24.0" />
                                                    </font>
                                                </Label>
                                            </children>
                                        </VBox>

                                        <VBox maxWidth="Infinity" spacing="3.0" style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.14), 8, 0, 0, 2);" HBox.hgrow="ALWAYS">

                                            <children>
                                                <Label fx:id="lblTituloCard2" text="Finalizadas" textFill="#606060" />
                                                <Label fx:id="lblPartidasFinalizadas" text="0" textFill="#2E7D32">
                                                    <font>
                                                        <Font name="System Bold" size="24.0" />
                                                    </font>
                                                </Label>
                                            </children>
                                        </VBox>

                                        <VBox maxWidth="Infinity" spacing="3.0" style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.14), 8, 0, 0, 2);" HBox.hgrow="ALWAYS">

                                            <children>
                                                <Label fx:id="lblTituloCard3" text="Gols" textFill="#606060" />
                                                <Label fx:id="lblTotalGols" text="0" textFill="#2E7D32">
                                                    <font>
                                                        <Font name="System Bold" size="24.0" />
                                                    </font>
                                                </Label>
                                            </children>
                                        </VBox>

                                        <VBox maxWidth="Infinity" spacing="3.0" style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.14), 8, 0, 0, 2);" HBox.hgrow="ALWAYS">

                                            <children>
                                                <Label fx:id="lblTituloCard4" text="Média" textFill="#606060" />
                                                <Label fx:id="lblMediaGols" text="0.00" textFill="#2E7D32">
                                                    <font>
                                                        <Font name="System Bold" size="24.0" />
                                                    </font>
                                                </Label>
                                            </children>
                                        </VBox>
                                    </children>
                                </HBox>

                                <HBox spacing="10.0" VBox.vgrow="ALWAYS">
                                    <children>

                                        <VBox maxWidth="Infinity" prefHeight="210.0" spacing="6.0" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.14), 8, 0, 0, 2);" HBox.hgrow="ALWAYS">

                                            <children>
                                                <Label text="Destaques" textFill="#2E7D32">
                                                    <font>
                                                        <Font name="System Bold" size="13.0" />
                                                    </font>
                                                </Label>

                                                <Label fx:id="lblPartidaMaisGols" text="Partida com mais gols: nenhum relatório gerado." textFill="#303030" wrapText="true" />

                                                <Label fx:id="lblMaiorGoleada" text="Maior goleada: nenhum relatório gerado." textFill="#303030" wrapText="true" />

                                                <Label fx:id="lblSelecaoAnalisada" text="Seleção analisada: nenhuma seleção selecionada." textFill="#303030" wrapText="true" />
                                            </children>
                                        </VBox>

                                        <VBox maxWidth="Infinity" prefHeight="210.0" spacing="6.0" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.14), 8, 0, 0, 2);" HBox.hgrow="ALWAYS">

                                            <children>
                                                <Label fx:id="lblTituloGrafico" text="Partidas por status" textFill="#2E7D32">

                                                    <font>
                                                        <Font name="System Bold" size="13.0" />
                                                    </font>
                                                </Label>

                                                <PieChart fx:id="graficoStatus" labelsVisible="false" legendVisible="true" maxWidth="Infinity" prefHeight="165.0" VBox.vgrow="ALWAYS" />
                                            </children>
                                        </VBox>

                                    </children>
                                </HBox>

                            </children>
                        </VBox>
                    </content>
                </ScrollPane>
            </center>
        </BorderPane>
    </children>
</AnchorPane>
